{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "scripts/**",
      "package.json",
      "bun.lock",
      "railpack.json",
      "railway.jobs.json"
    ]
  },
  "deploy": {
    "startCommand": "bun run scripts/run-scheduled-jobs.ts",
    "cronSchedule": "0 13 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
