generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoPersona {
  FISICA
  MORAL
}

enum UserRole {
  MASTER_ADMIN
  OWNER
  AGENT
  CLIENT
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum Periodicidad {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum SuscripcionStatus {
  TRIAL
  ACTIVA
  CANCELADA
  VENCIDA
  SUSPENDIDA
}

enum OrdenStatus {
  PENDIENTE
  PAGADA
  FALLIDA
  CANCELADA
}

enum PolizaStatus {
  COTIZACION
  VIGENTE
  PROXIMA_A_VENCER
  VENCIDA
  CANCELADA
  RENOVADA
}

model Company {
  id               String       @id @default(uuid())
  razonSocial      String?
  nombreComercial  String?
  rfc              String?
  tipoPersona      TipoPersona?
  emailContacto    String
  telefonoContacto String
  pais             String?
  estado           String?

  /// dias de anticipacion para avisar de polizas por vencer (RF-POL-NOTIF-01)
  avisoVencimientoDias Int[] @default([30, 15, 7])

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  users          User[]
  suscripciones  Suscripcion[]
  aseguradoras   Aseguradora[]
  ramos          Ramo[]
  columnasKanban ColumnaKanban[]
  tareasKanban   TareaKanban[]
  polizas        Poliza[]
  siniestros     Siniestro[]
  glosarios      Glosario[]

  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  companyId    String?
  role         UserRole  @default(AGENT)
  firstName    String
  lastName     String
  email        String
  phone        String
  passwordHash String
  lastLoginAt  DateTime?
  active       Boolean   @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company            Company?        @relation(fields: [companyId], references: [id])
  polizasComoCliente Poliza[]        @relation("PolizaCliente")
  detalleCliente     DetalleCliente?

  siniestrosComoCliente Siniestro[] @relation("SiniestroCliente")
  siniestrosCreados     Siniestro[] @relation("SiniestroCreadoPor")

  @@unique([companyId, email], name: "company_email_unique")
  @@map("users")
}

model Plan {
  id                     String       @id @default(uuid())
  nombre                 String       @unique
  descripcion            String?
  precio                 Float
  periodicidad           Periodicidad
  limiteUsuarios         Int
  limiteAlmacenamientoGB Float?
  features               Json?
  active                 Boolean      @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  suscripciones Suscripcion[]

  @@map("plans")
}

model Suscripcion {
  id                   String            @id @default(uuid())
  companyId            String
  planId               String
  suscripcionStatus    SuscripcionStatus @default(TRIAL)
  active               Boolean           @default(true)
  fechaInicio          DateTime
  fechaFin             DateTime?
  fechaProximoPago     DateTime
  renovacionAutomatica Boolean           @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])
  ordenes Orden[]

  @@map("suscripciones")
}

model Orden {
  id               String      @id @default(uuid())
  suscripcionId    String
  cicloInicio      DateTime
  cicloFin         DateTime
  monto            Float
  moneda           String      @default("MXN")
  ordenStatus      OrdenStatus @default(PENDIENTE)
  active           Boolean     @default(true)
  proveedor        String?
  proveedorOrdenId String?
  proveedorPagoId  String?
  pagadaEn         DateTime?
  motivoFallo      String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  suscripcion Suscripcion @relation(fields: [suscripcionId], references: [id])

  @@map("ordenes")
}

model Aseguradora {
  id          String  @id @default(uuid())
  companyId   String
  nombre      String
  descripcion String?
  active      Boolean @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  polizas Poliza[]

  @@unique([companyId, nombre], name: "company_nombre_unique")
  @@map("aseguradoras")
}

model Ramo {
  id          String  @id @default(uuid())
  companyId   String
  nombre      String
  descripcion String?
  active      Boolean @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  polizas Poliza[]

  @@unique([companyId, nombre], name: "ramo_company_nombre_unique")
  @@map("ramos")
}

model ColumnaKanban {
  id        String @id @default(uuid())
  companyId String
  nombre    String
  prioridad Int

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  tareas  TareaKanban[]

  @@unique([companyId, prioridad], name: "columna_kanban_company_prioridad_unique")
  @@index([companyId, nombre])
  @@map("columnas_kanban")
}

model Poliza {
  id               String       @id @default(uuid())
  companyId        String
  aseguradoraId    String
  ramoId           String
  clienteUserId    String
  numeroPoliza     String
  fechaInicio      DateTime
  fechaVencimiento DateTime
  primaNeta        Float
  primaTotal       Float
  polizaStatus     PolizaStatus @default(VIGENTE)
  active           Boolean      @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company      Company         @relation(fields: [companyId], references: [id])
  aseguradora  Aseguradora     @relation(fields: [aseguradoraId], references: [id])
  ramo         Ramo            @relation(fields: [ramoId], references: [id])
  cliente      User            @relation("PolizaCliente", fields: [clienteUserId], references: [id])
  tareasKanban TareaKanban[]
  siniestros   Siniestro[]
  archivos     ArchivoPoliza[]

  @@unique([companyId, numeroPoliza], name: "poliza_company_numero_unique")
  @@index([companyId, clienteUserId])
  @@map("polizas")
}

model TareaKanban {
  id              String  @id @default(uuid())
  companyId       String
  columnaKanbanId String?
  polizaId        String?
  titulo          String
  descripcion     String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  columnaKanban ColumnaKanban? @relation(fields: [columnaKanbanId], references: [id], onDelete: SetNull)
  poliza        Poliza?        @relation(fields: [polizaId], references: [id], onDelete: SetNull)

  @@index([companyId, columnaKanbanId])
  @@index([companyId, polizaId])
  @@map("tareas_kanban")
}

model DetalleCliente {
  id              String    @id @default(uuid())
  userId          String    @unique
  fechaNacimiento DateTime?
  rfc             String?
  curp            String?
  direccion       String?
  ciudad          String?
  estado          String?
  codigoPostal    String?
  notas           String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("detalle_clientes")
}

enum SiniestroStatus {
  REPORTADO
  EN_REVISION
  APROBADO
  RECHAZADO
  PAGADO
  CERRADO
}

model Siniestro {
  id              String          @id @default(uuid())
  companyId       String
  polizaId        String
  clienteUserId   String
  creadoPorUserId String
  tipoSiniestro   String?
  fechaEvento     DateTime
  descripcion     String?
  ajustador       String?
  montoEstimado   Float?
  montoPagado     Float?
  siniestroStatus SiniestroStatus @default(REPORTADO)
  active          Boolean         @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company   Company            @relation(fields: [companyId], references: [id])
  poliza    Poliza             @relation(fields: [polizaId], references: [id])
  cliente   User               @relation("SiniestroCliente", fields: [clienteUserId], references: [id])
  creadoPor User               @relation("SiniestroCreadoPor", fields: [creadoPorUserId], references: [id])
  archivos  ArchivoSiniestro[]

  @@index([companyId, polizaId])
  @@index([companyId, clienteUserId])
  @@map("siniestros")
}

model ArchivoPoliza {
  id          String  @id @default(uuid())
  polizaId    String
  nombre      String
  mimeType    String
  storageKey  String
  tamanoBytes Int
  active      Boolean @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  poliza Poliza @relation(fields: [polizaId], references: [id])

  @@index([polizaId])
  @@map("archivos_polizas")
}

model ArchivoSiniestro {
  id          String  @id @default(uuid())
  siniestroId String
  nombre      String
  mimeType    String
  storageKey  String
  tamanoBytes Int
  active      Boolean @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  siniestro Siniestro @relation(fields: [siniestroId], references: [id])

  @@index([siniestroId])
  @@map("archivos_siniestros")
}

enum NotificacionTipo {
  POLIZA_POR_VENCER
  HITO_ALERTA
}

/// bitacora y anti-duplicado de envios automaticos. `marca` distingue el umbral
/// concreto ("30", "15", "7" para polizas; "PROXIMO"/"HOY"/"VENCIDO" para hitos)
/// para que un reintento del scheduler no reenvie el mismo aviso
model NotificacionEnviada {
  id        String           @id @default(uuid())
  tipo      NotificacionTipo
  entidadId String
  marca     String
  enviadoEn DateTime         @default(now())

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tipo, entidadId, marca], name: "notificacion_unica_por_umbral")
  @@index([tipo, enviadoEn])
  @@map("notificaciones_enviadas")
}

model Glosario {
  id          String  @id @default(uuid())
  companyId   String
  titulo      String
  descripcion String
  active      Boolean @default(true)

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, titulo], name: "glosario_company_titulo_unique")
  @@map("glosarios")
}
