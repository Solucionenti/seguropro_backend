# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://segur:segur@localhost:5432/segur_dev

# JWT
JWT_SECRET=your-super-secret-key-at-least-32-chars-long
JWT_ACCESS_EXPIRATION=15m
