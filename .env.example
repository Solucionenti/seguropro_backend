# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://segur:segur@localhost:5432/segur_dev

# JWT
JWT_SECRET=your-super-secret-key-at-least-32-chars-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PASSWORD_RESET_EXPIRATION=15m
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Segur <no-reply@tudominio.com>

# Frontend base URL used to build the password reset link
APP_URL=http://localhost:5173
# Public base URL of THIS api, used to build signed file urls
API_URL=http://localhost:3000

# File storage (local driver keeps binaries on disk; swap for an S3-compatible provider in prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_FILE_SIZE_MB=10

# S3-compatible storage (R2 / Backblaze B2 / Supabase / AWS).
# Leave blank while STORAGE_DRIVER=local. Set STORAGE_DRIVER=s3 to switch;
# boot fails fast if the driver is s3 and any of the four is missing.
S3_BUCKET=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Secret the external scheduler (Lambda / Worker / cron-job.org) sends to the job endpoints
JOB_SECRET=change-me-at-least-32-characters-long

# Days of notice for upcoming milestones (overdue and due-today always notify)
HITO_AVISO_DIAS=3,1
