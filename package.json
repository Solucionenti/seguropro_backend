{
  "name": "segur-back",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "ts": "tsc --noEmit",
    "build": "bunx prisma generate",
    "build:bin": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server_bin src/index.ts",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:push": "bunx prisma migrate deploy",
    "db:reset": "bunx prisma migrate reset",
    "db:seed": "bunx prisma db seed",
    "db:studio": "bunx prisma studio",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "jobs:run": "bun run scripts/run-scheduled-jobs.ts",
    "deploy:prepare": "bun run scripts/deploy-prepare.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/bun": "1.3.9",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "railway": "3.11.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.1",
    "@elysiajs/openapi": "1.4.14",
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "7.4.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "dotenv": "17.3.1",
    "elysia": "1.4.27",
    "jose": "6.2.0",
    "pg": "8.19.0",
    "prisma": "7.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.36",
    "zod-to-json-schema": "3.25.1"
  }
}
